{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topic2reel spec",
  "description": "Input for topic2reel.py. topic2reel.py's validator is authoritative (it also checks lengths and that on-screen text is Roman script).",
  "type": "object",
  "required": ["caption", "hashtags", "scenes"],
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string"},
    "caption": {"type": "string", "maxLength": 600, "description": "Instagram caption, Hinglish allowed, emojis ok"},
    "hashtags": {"type": "array", "items": {"type": "string", "pattern": "^#\\w+$"}, "minItems": 3, "maxItems": 12},
    "scenes": {
      "type": "array", "minItems": 4, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["type", "headline", "voice"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["hook", "cards", "myth_fact", "stat", "steps", "compare", "cta"]},
          "headline": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "maxLength": 24}, "description": "Roman script only"},
          "highlight": {"type": "array", "items": {"type": "string"}, "description": "Words from headline to mark with a highlighter"},
          "caption": {"type": "string", "maxLength": 48, "description": "Small pill at the bottom, optional"},
          "voice": {"type": "string", "maxLength": 400, "description": "Spoken line for TTS, Devanagari for Hindi"},
          "emoji": {"type": "string", "maxLength": 12},
          "stamp": {"enum": ["no", "yes"]},
          "badge": {"type": "string", "maxLength": 26},
          "items": {"type": "array", "minItems": 2, "maxItems": 6,
                    "items": {"type": "object", "additionalProperties": false,
                              "properties": {"emoji": {"type": "string"}, "label": {"type": "string", "maxLength": 18}, "text": {"type": "string", "maxLength": 60}}}},
          "highlight_index": {"type": "integer", "minimum": 0},
          "myth": {"type": "string", "maxLength": 90},
          "fact": {"type": "string", "maxLength": 90},
          "value": {"type": "string", "maxLength": 10},
          "label": {"type": "string", "maxLength": 60},
          "sub": {"type": "string", "maxLength": 40},
          "left": {"$ref": "#/definitions/side"},
          "right": {"$ref": "#/definitions/side"},
          "primary": {"type": "string", "maxLength": 24},
          "secondary": {"type": "string", "maxLength": 24},
          "handle": {"type": "string", "maxLength": 24}
        }
      }
    }
  },
  "definitions": {
    "side": {"type": "object", "required": ["emoji", "label"], "additionalProperties": false,
             "properties": {"emoji": {"type": "string"}, "label": {"type": "string", "maxLength": 40}}}
  }
}
